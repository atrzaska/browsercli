{
  "name": "browsercli",
  "version": "0.1.0",
  "description": "Control your real Chrome browser from the command line (for humans and AI agents) via the Chrome DevTools Protocol",
  "author": "Andrzej Trzaska",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atrzaska/browsercli.git"
  },
  "homepage": "https://github.com/atrzaska/browsercli#readme",
  "bugs": {
    "url": "https://github.com/atrzaska/browsercli/issues"
  },
  "keywords": [
    "chrome",
    "devtools-protocol",
    "cdp",
    "browser-automation",
    "cli",
    "ai-agents",
    "agent-skills"
  ],
  "type": "module",
  "bin": {
    "browsercli": "dist/cli.js"
  },
  "files": [
